package com.graphify.backend.service.chat;

import com.graphify.backend.entity.ChatMessage;
import com.graphify.backend.entity.Document;
import com.graphify.backend.entity.DocumentChunk;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

@Service
public class ChatPromptBuilder {
    private static final String USER_LABEL = "\uC0AC\uC6A9\uC790";
    private static final String ASSISTANT_LABEL = "\uC5B4\uC2DC\uC2A4\uD134\uD2B8";
    private static final String NO_DOCUMENTS_SYSTEM_PROMPT =
        "\uB2F9\uC2E0\uC740 \uD68C\uC0AC \uC9C0\uC2DD\uBCA0\uC774\uC2A4 \uAE30\uBC18 \uC9C8\uC758\uC751\uB2F5 \uC5B4\uC2DC\uC2A4\uD134\uD2B8\uC785\uB2C8\uB2E4.\n"
            + "\uD604\uC7AC \uCC38\uACE0\uD560 \uBB38\uC11C\uAC00 \uC81C\uACF5\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n"
            + "\uC77C\uBC18 \uC9C0\uC2DD\uC73C\uB85C \uB2F5\uBCC0\uD558\uB418, \uB2F5\uBCC0 \uCCAB\uBA38\uB9AC\uC5D0 "
            + "\"(\uC81C\uACF5\uB41C \uBB38\uC11C \uC5C6\uC774 \uC77C\uBC18 \uC9C0\uC2DD\uC73C\uB85C \uB2F5\uBCC0\uD569\uB2C8\uB2E4)\""
            + "\uB77C\uACE0 \uBA85\uC2DC\uD558\uC138\uC694.";
    private static final String DOCUMENTS_SYSTEM_PROMPT =
        "\uB2F9\uC2E0\uC740 \uD68C\uC0AC \uC9C0\uC2DD\uBCA0\uC774\uC2A4 \uAE30\uBC18 \uC9C8\uC758\uC751\uB2F5 \uC5B4\uC2DC\uC2A4\uD134\uD2B8\uC785\uB2C8\uB2E4.\n"
            + "\uBC18\uB4DC\uC2DC \uC544\uB798 \uC81C\uACF5\uB41C \uBB38\uC11C\uC758 \uB0B4\uC6A9\uB9CC \uC0AC\uC6A9\uD574\uC11C \uB2F5\uBCC0\uD558\uC138\uC694.\n"
            + "\uBB38\uC11C\uC5D0 \uC5C6\uB294 \uB0B4\uC6A9\uC740 \uCD94\uCE21\uD558\uC9C0 \uB9D0\uACE0 "
            + "\"\uC81C\uACF5\uB41C \uBB38\uC11C\uC5D0\uC11C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\"\uB77C\uACE0 \uB2F5\uD558\uC138\uC694.\n"
            + "\uB2F5\uBCC0 \uB05D\uC5D0 \uBC18\uB4DC\uC2DC \"Sources: <\uC2E4\uC81C\uB85C \uC0AC\uC6A9\uD55C "
            + "\uBB38\uC11C \uC81C\uBAA9\uB4E4\uC744 \uC27C\uD45C\uB85C \uAD6C\uBD84>\" \uD615\uC2DD\uC73C\uB85C "
            + "\uC778\uC6A9\uC744 \uBA85\uC2DC\uD558\uC138\uC694.\n"
            + "\uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC740 \uBB38\uC11C\uB294 \uC778\uC6A9\uD558\uC9C0 \uB9C8\uC138\uC694.\n\n"
            + "--- \uC81C\uACF5\uB41C \uBB38\uC11C ---\n%s\n--- \uB05D ---";

    private final int maxContextChars;
    private final int maxDocumentsPerAnswer;
    private final int historyTurns;

    public ChatPromptBuilder(@Value("${graphify.chat.max-context-chars:100000}") int maxContextChars,
                             @Value("${graphify.chat.max-documents-per-answer:20}") int maxDocumentsPerAnswer,
                             @Value("${graphify.chat.history-turns:5}") int historyTurns) {
        this.maxContextChars = maxContextChars;
        this.maxDocumentsPerAnswer = maxDocumentsPerAnswer;
        this.historyTurns = historyTurns;
    }

    public record BuiltPrompt(String systemPrompt, String userPrompt, List<Document> includedDocuments) {}

    public BuiltPrompt build(String userQuestion,
                             List<Document> candidateDocuments,
                             List<DocumentChunk> allChunks,
                             List<ChatMessage> history) {
        List<Document> sortedDocuments = safeDocuments(candidateDocuments).stream()
            .sorted(Comparator.comparing(Document::getCreatedAt, Comparator.nullsLast(LocalDateTime::compareTo)).reversed())
            .limit(Math.max(0, maxDocumentsPerAnswer))
            .toList();
        Map<Long, List<DocumentChunk>> chunksByDocumentId = groupChunks(allChunks);

        StringBuilder documentBlocks = new StringBuilder();
        List<Document> includedDocuments = new ArrayList<>();
        int usedChars = 0;
        int documentIndex = 1;
        for (Document document : sortedDocuments) {
            String block = buildDocumentBlock(documentIndex, document, chunksByDocumentId.get(document.getId()));
            if (usedChars + block.length() > maxContextChars) {
                break;
            }

            documentBlocks.append(block);
            includedDocuments.add(document);
            usedChars += block.length();
            documentIndex++;
        }

        String systemPrompt = includedDocuments.isEmpty()
            ? NO_DOCUMENTS_SYSTEM_PROMPT
            : DOCUMENTS_SYSTEM_PROMPT.formatted(documentBlocks.toString().trim());
        return new BuiltPrompt(systemPrompt, buildUserPrompt(userQuestion, history), List.copyOf(includedDocuments));
    }

    private List<Document> safeDocuments(List<Document> candidateDocuments) {
        return candidateDocuments == null ? List.of() : candidateDocuments;
    }

    private Map<Long, List<DocumentChunk>> groupChunks(List<DocumentChunk> allChunks) {
        Map<Long, List<DocumentChunk>> chunksByDocumentId = new LinkedHashMap<>();
        if (allChunks == null) {
            return chunksByDocumentId;
        }

        List<DocumentChunk> sortedChunks = allChunks.stream()
            .filter(chunk -> chunk != null && chunk.getDocument() != null && chunk.getDocument().getId() != null)
            .sorted(Comparator
                .comparing((DocumentChunk chunk) -> chunk.getDocument().getId())
                .thenComparing(DocumentChunk::getChunkIndex, Comparator.nullsLast(Integer::compareTo)))
            .toList();

        for (DocumentChunk chunk : sortedChunks) {
            chunksByDocumentId.computeIfAbsent(chunk.getDocument().getId(), ignored -> new ArrayList<>()).add(chunk);
        }
        return chunksByDocumentId;
    }

    private String buildDocumentBlock(int documentIndex, Document document, List<DocumentChunk> chunks) {
        StringBuilder builder = new StringBuilder();
        builder.append("=== Document ")
            .append(documentIndex)
            .append(": ")
            .append(document.getTitle())
            .append(" (id=")
            .append(document.getId())
            .append(") ===\n");

        List<DocumentChunk> safeChunks = chunks == null ? List.of() : chunks.stream()
            .sorted(Comparator.comparing(DocumentChunk::getChunkIndex, Comparator.nullsLast(Integer::compareTo)))
            .toList();

        if (safeChunks.isEmpty()) {
            builder.append(fallbackDocumentText(document)).append('\n');
        } else {
            for (DocumentChunk chunk : safeChunks) {
                if (chunk.getContent() == null || chunk.getContent().isBlank()) {
                    continue;
                }
                builder.append(chunk.getContent()).append('\n');
            }
        }

        builder.append("=== End Document ")
            .append(documentIndex)
            .append(" ===\n\n");
        return builder.toString();
    }

    private String fallbackDocumentText(Document document) {
        if (document.getSummary() != null && !document.getSummary().isBlank()) {
            return document.getSummary();
        }
        return "(document has no extracted text)";
    }

    private String buildUserPrompt(String userQuestion, List<ChatMessage> history) {
        List<ChatMessage> supportedHistory = history == null
            ? new ArrayList<>()
            : history.stream().filter(this::isSupportedHistoryMessage).collect(ArrayList::new, ArrayList::add, ArrayList::addAll);

        if (!supportedHistory.isEmpty()) {
            ChatMessage lastMessage = supportedHistory.get(supportedHistory.size() - 1);
            if (isDuplicateCurrentQuestion(lastMessage, userQuestion)) {
                supportedHistory.remove(supportedHistory.size() - 1);
            }
        }

        int fromIndex = Math.max(0, supportedHistory.size() - Math.max(0, historyTurns));
        List<String> lines = supportedHistory.subList(fromIndex, supportedHistory.size()).stream()
            .map(this::formatHistoryLine)
            .toList();

        StringBuilder builder = new StringBuilder();
        if (!lines.isEmpty()) {
            builder.append(String.join("\n", lines)).append('\n');
        }
        builder.append(USER_LABEL).append(": ").append(userQuestion == null ? "" : userQuestion.trim()).append('\n');
        builder.append(ASSISTANT_LABEL).append(':');
        return builder.toString();
    }

    private boolean isSupportedHistoryMessage(ChatMessage message) {
        if (message == null || message.getRole() == null) {
            return false;
        }
        String normalizedRole = message.getRole().trim().toUpperCase(Locale.ROOT);
        return "USER".equals(normalizedRole) || "ASSISTANT".equals(normalizedRole);
    }

    private boolean isDuplicateCurrentQuestion(ChatMessage message, String userQuestion) {
        return message.getContent() != null
            && userQuestion != null
            && "USER".equalsIgnoreCase(message.getRole())
            && message.getContent().trim().equals(userQuestion.trim());
    }

    private String formatHistoryLine(ChatMessage message) {
        String speaker = "USER".equalsIgnoreCase(message.getRole()) ? USER_LABEL : ASSISTANT_LABEL;
        return speaker + ": " + message.getContent();
    }
}
